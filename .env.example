# Core
FPC_CONFIG=config.yaml
DATABASE_PATH=data/copilot.db
PUBLIC_BASE_URL=http://127.0.0.1:8765
POLL_SECONDS=60
TRACKER_PATH=/path/to/your/OneDrive/Freelance_Application_Tracker.xlsx

# AI drafting (OpenAI-compatible Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Freelancer.com official API
FREELANCER_OAUTH_TOKEN=
FREELANCER_API_BASE=https://www.freelancer.com/api

# Microsoft 365 delegated Mail.Read for alert/reply-email monitoring
M365_CLIENT_ID=
M365_TENANT_ID=common
M365_ACCESS_TOKEN=
M365_TOKEN_CACHE=data/msal_cache.json

# Notifications (configure one or both)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OFF by default. Read-only Playwright scanning is unsupported by some platforms
# and can still trigger enforcement; never enable for Upwork without written approval.
ENABLE_EXPERIMENTAL_BROWSER=false
BROWSER_PROFILE_DIR=data/browser-profile
